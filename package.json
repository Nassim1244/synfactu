    "pino": "10.3.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
