// Prisma schema. Owned by the architect; no other agent edits this file
// (`ai-rules/policy_architecture.md` -> Schema and migrations).
//
// There are no models yet, and that is deliberate. `specs/001-hello-world.md`
// renders without touching the database, and the domain entities described in
// `specs/functional/` - clients, missions, time entries, invoices - arrive
// with feature v01-001 onward, each through the normal workflow with its own
// spec. A speculative table is worse than no table: it becomes a migration
// someone has to undo.
//
// There is also no `prisma/migrations/` directory yet, for the same reason.
// `prisma migrate dev` creates nothing from a model-less schema, and
// `prisma migrate deploy` exits 0 without one while still creating the SQLite
// file - so `docker/entrypoint.sh` and the health check both work today. The
// first migration, and `migration_lock.toml` with it, arrive with the first
// real model (AD-020).

// The v7 generator. It emits TypeScript source into the directory below
// rather than patching `node_modules/.prisma`, which is why the output path
// is explicit and why `src/generated/` is git-ignored: this is build output
// that happens to live in the source tree, recreated by `prisma generate`.
//
// `src/generated/` rather than a folder under `src/lib/`, because everything
// else in `src/` is hand-written and the boundary has to be obvious to both a
// reader and an ignore file. Only `src/lib/db.ts` and the feature repositories
// may import from it (AD-004).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// No `url` here: Prisma 7 removed it from the schema. The connection string
// lives in `prisma.config.ts` at the repository root for Migrate, and reaches
// the client at runtime through the driver adapter (AD-020). DATABASE_URL
// itself is still the single source of truth, validated in `src/lib/config.ts`
// (AD-013, AD-014).
datasource db {
  provider = "sqlite"
}

// v01-001 - the first real models. PascalCase model names, camelCase fields,
// mapped to snake_case tables/columns via @map/@@map (AD-023). Money is an
// integer number of cents (AD-007); createdAt/updatedAt are UTC (AD-008).

/// An intermediary who refers end clients. It may also be billed directly
/// under either regime - that case is represented by a separate Client
/// record, not by this model (specs/functional/MCD v2.md -> PARTNER, RG-01).
model Partner {
  id        Int      @id @default(autoincrement())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clients Client[]

  @@map("partners")
}

/// Billing regime a client defaults to (specs/functional/MCD v2.md ->
/// REGIME). A fixed, closed pair - not user-managed by v01-001 (AD-022).
/// Becomes a lookup table if a later feature adds REGIME_RATE historization.
enum Regime {
  MICRO
  PORTAGE
}

/// An end client, optionally linked to a referring Partner
/// (specs/functional/MCD v2.md -> CLIENT, RG-01). `defaultRateCents` is the
/// TJM that pre-fills new missions (D-06), stored as an integer number of
/// cents (AD-007) - see `Money` in `src/lib/money/`. `shortLabel` feeds the
/// invoice numbering pattern (D-47).
model Client {
  id               Int      @id @default(autoincrement())
  name             String
  shortLabel       String   @map("short_label")
  billable         Boolean  @default(true)
  active           Boolean  @default(true)
  defaultRateCents Int      @map("default_rate_cents")
  regime           Regime?
  partnerId        Int?     @map("partner_id")
  partner          Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("clients")
}

// v01-003 - the operator's legal identity and the application's global
// settings. Both are additive, singleton/registry-style tables with no
// seeded row (AD-031): the repository returns a coded default when a row is
// absent, and a row is written only on the user's first real edit.

/// The operator's own legal identity - name, SIRET, address and contact
/// details used on every invoice (specs/functional/MCD v2.md ->
/// COMPANY_PROFILE, D-35). A single row, fixed id 1, enforced by the
/// application. Never seeded (AD-031): every field is nullable so "no row
/// yet" and "saved, with phone left blank" are both representable with no
/// invented placeholder value.
model CompanyProfile {
  id         Int      @id @default(1)
  legalName  String?  @map("legal_name")
  siret      String?
  street     String?
  postalCode String?  @map("postal_code")
  city       String?
  email      String?
  phone      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("company_profile")
}

/// A single named application setting (specs/functional/MCD v2.md -> SETTING,
/// D-35, D-50). Keys are declared, typed and defaulted in a Zod registry in
/// code (`src/features/settings/schema.ts`); a key with no row yet reads as
/// its registry default rather than being seeded (AD-031). `value` is `Json`
/// so a key's own type (number, string or boolean) round-trips with no manual
/// serialisation step.
model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
