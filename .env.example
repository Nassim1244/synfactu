# Environment variables read by the application.
#
# Every variable declared in `src/lib/config.ts` is listed here with a safe
# placeholder. Never a real value: this file is committed, `.env` is not
# (AD-014, `ai-rules/policy_security.md` -> Secrets).
#
# Copy to `.env` for local development:
#     cp .env.example .env
#
# A missing or malformed variable stops the application at startup with a
# message naming it. That is deliberate - see `ai-rules/policy_architecture.md`
# -> Configuration.

# --- Required -----------------------------------------------------------
# Database connection string (AD-013). SQLite today, so a `file:` URL.
# Point it at the Docker volume, never inside the source tree: the production
# stack mounts the volume at /data, the development stack uses /data/dev.db.
DATABASE_URL="file:/data/dev.db"

# --- Optional, with a default -------------------------------------------
# pino log level (AD-012). One of: trace, debug, info, warn, error, fatal,
# silent. Defaults to "info" when unset.
LOG_LEVEL="info"

# --- Set by the runtime, not by you -------------------------------------
# NODE_ENV is declared in the config module but must NOT be set here. Next
# reads this file, and a value pinned in it would follow `next dev` and
# `next build` around and mix development and production React builds.
# The toolchain sets it: "development" under `next dev`, "production" under
# `next build` and `next start`, "test" under Vitest. Unset, the config
# module reads it as "production", which is the safe direction.
# Accepted values: development | test | production
#
# NODE_ENV="production"

# --- Not declared yet ---------------------------------------------------
# No BETTER_AUTH_SECRET or BETTER_AUTH_URL: authentication was skipped at
# bootstrap (AD-017). They arrive with Better Auth, together with the command
# that generates the secret.
